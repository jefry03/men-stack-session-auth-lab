<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Entry</title>
</head>
<body>
    <%- include('../partials/navbar') %>

    <h1>Edit Entry</h1>

    <form action="/entries/<%= entry._id %>?_method=PUT" method="POST">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" maxlength="100" value="<%= entry.title %>" required>

        <label for="entryBody">Entry</label>
        <textarea id="entryBody" name="entryBody" maxlength="350"><%= entry.entryBody %></textarea>

        <label for="isPublic">Public?</label>
        <input type="checkbox" id="isPublic" name="isPublic" <% if (entry.isPublic) { %>checked<% } %>>

        <button type="submit">Save</button>
    </form>
</body>
</html>