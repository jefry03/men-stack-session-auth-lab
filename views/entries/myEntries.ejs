<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>My Entries</h1>

<% entries.forEach(entry => { %>
    <article>
        <h2><%= entry.title %></h2>
        <p><%= entry.entryBody %></p>
        <small><%= entry.isPublic ? 'Public' : 'Private' %></small>
    </article>
<% }) %>
</body>
</html>